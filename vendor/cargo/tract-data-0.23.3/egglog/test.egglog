(let a (Var "a"))
(let term (Div (Add a one) 4))
(let mul1 (Mul (Add (Mul term two) (Num -3)) (Add term mone)))
(let mul2 (Mul (Add term mone) (Add (Mul term two) (Num -3))))
(let x (Add mul1 (Mul mul2 mone)))
(run 10)
(extract x)
